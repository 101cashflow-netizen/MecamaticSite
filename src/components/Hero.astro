---
import { TALLER_DATA } from '../data/taller';
import Icon from './Icon.astro';

const { empresa } = TALLER_DATA;
const whatsappHeroUrl = `https://wa.me/${empresa.whatsappNumero}?text=${encodeURIComponent("Olá, quero solicitar um diagnóstico técnico da minha empresa em Guarujá.")}`;
---

<section class="w-full bg-background relative overflow-hidden py-14 lg:py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-outline-variant">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
    <!-- Coluna de Texto e Gatilhos -->
    <div class="lg:col-span-7 flex flex-col space-y-6">
      <!-- Tag Técnica com Hazard Accent -->
      <div class="inline-flex items-center self-start border-2 border-outline-variant bg-surface-container-low px-3 py-1">
        <span class="w-3 h-3 bg-primary-container mr-2 shrink-0"></span>
        <span class="font-label-code text-label-code uppercase text-primary-container tracking-widest text-xs">
          [GUARUJA TEC // OPERAÇÃO LOCAL - ENSEADA, GUARUJÁ]
        </span>
      </div>

      <!-- Headline Imponente -->
      <div class="space-y-2">
        <h1 class="font-headline-display text-headline-display-mobile lg:text-headline-display uppercase text-on-surface font-extrabold tracking-tight leading-none">
          Aumente suas vendas <br class="hidden sm:inline" />
          <span class="text-primary-container underline decoration-primary-container decoration-4 underline-offset-8">em até 3x</span> com nossa solução simples
        </h1>
        <p class="font-headline-sm text-headline-sm uppercase text-secondary tracking-normal pt-2">
          {empresa.subtitulo}
        </p>
      </div>

      <!-- Subtítulo Operacional -->
      <p class="font-body-lg text-body-lg text-secondary max-w-2xl leading-relaxed">
        {empresa.descricaoCompleta}
      </p>

      <!-- Triggers de Conversão Imediata -->
      <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
        <a
          class="bg-primary-container text-on-primary-fixed font-label-action text-label-action uppercase px-6 py-4 flex items-center justify-center gap-3 border-2 border-background shadow-[4px_4px_0px_0px_#000000] hover:bg-primary transition-all active:translate-x-0.5 active:translate-y-0.5"
          href={whatsappHeroUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="chat" class="w-6 h-6 text-on-primary-fixed" />
          <span>AGENDAR PELO WHATSAPP</span>
        </a>

        <a
          class="bg-surface-container-low text-on-surface font-label-action text-label-action uppercase px-6 py-4 flex items-center justify-center gap-3 border-2 border-outline-variant hover:border-primary-container hover:text-primary-container transition-all"
          href={empresa.telefoneLink}
        >
          <Icon name="call" class="w-6 h-6 text-primary-container" />
          <span>LIGAR AGORA: {empresa.telefoneFormatado}</span>
        </a>
      </div>

      <!-- Prova Social & Status Técnico -->
      <div class="pt-4 flex flex-wrap items-center gap-6 border-t border-outline-variant">
        <div class="flex items-center gap-3 bg-surface-container-low p-2.5 border border-outline-variant">
          <div class="flex text-primary-container gap-0.5">
            <Icon name="star" class="w-5 h-5" filled={true} />
            <Icon name="star" class="w-5 h-5" filled={true} />
            <Icon name="star" class="w-5 h-5" filled={true} />
            <Icon name="star" class="w-5 h-5" filled={true} />
            <Icon name="star" class="w-5 h-5" filled={true} />
          </div>
          <div class="flex flex-col">
            <span class="font-headline-sm text-sm uppercase text-on-surface leading-none font-bold">
              Nota {empresa.notaMedia.toString().replace('.', ',')} de {empresa.totalAvaliacoes} avaliações
            </span>
            <span class="font-label-code text-[11px] text-secondary">AUDITADO GOOGLE MAPS</span>
          </div>
        </div>

        <div class="flex items-center gap-2.5 px-3 py-2 bg-surface-container-low border border-outline-variant" data-status-container>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_6px_#34d399]" data-status-ping></span>
          <div class="flex flex-col">
            <span class="font-label-code text-xs text-on-surface uppercase font-bold" data-status-text>Aberto agora · Fecha às 18:00</span>
            <span class="font-label-code text-[10px] text-secondary uppercase">Segunda a Sábado</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Coluna Visual / Bancada Técnica -->
    <div class="lg:col-span-5 relative">
      <div class="relative bg-surface-container-high border-2 border-outline-variant p-2 shadow-[8px_8px_0px_0px_#000000]">
        <!-- Barra de Régua Técnica Superior -->
        <div class="flex items-center justify-between bg-surface-container-lowest px-3 py-1.5 border-b border-outline-variant font-label-code text-[11px] text-secondary">
          <span>CALIB_SPEC // 1440.0PX</span>
          <span class="text-primary-container">PAINEL OPERACIONAL LOCAL</span>
        </div>

        <!-- Moldura Fotográfica com Imagem Otimizada -->
        <div class="relative w-full h-[360px] sm:h-[400px] overflow-hidden bg-surface-container-lowest border border-outline-variant">
          <picture>
            <source media="(max-width: 640px)" srcset="/fotos/hero-mobile.webp" type="image/webp" />
            <img
              class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-500"
              alt="Bancada técnica de marketing e automação no Guarujá com múltiplos monitores e métricas"
              src="/fotos/hero-bancada.webp"
              width="640"
              height="400"
              loading="eager"
              fetchpriority="high"
            />
          </picture>

          <!-- Grid Overlay Técnico -->
          <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffc40015_1px,transparent_1px),linear-gradient(to_bottom,#ffc40015_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

          <!-- Etiqueta Flutuante de Inspeção -->
          <div class="absolute bottom-4 left-4 right-4 bg-surface-container-lowest/95 border-2 border-primary-container p-3 flex items-center justify-between">
            <div>
              <span class="font-label-code text-[10px] uppercase text-primary-container block font-bold">[REGISTRO DE BANCADA #GT-84]</span>
              <span class="font-headline-sm text-sm uppercase text-on-surface font-bold">Unidade Enseada // Automação Ativa</span>
            </div>
            <Icon name="precision_manufacturing" class="w-6 h-6 text-primary-container" />
          </div>
        </div>

        <!-- Régua Milimetrada Inferior -->
        <div class="w-full h-3 bg-surface-container-lowest flex justify-between items-center px-1 border-t border-outline-variant">
          <div class="w-1 h-2 bg-outline-variant"></div>
          <div class="w-1 h-1 bg-outline-variant"></div>
          <div class="w-1 h-2 bg-outline-variant"></div>
          <div class="w-1 h-1 bg-outline-variant"></div>
          <div class="w-1 h-2 bg-primary-container"></div>
          <div class="w-1 h-1 bg-outline-variant"></div>
          <div class="w-1 h-2 bg-outline-variant"></div>
          <div class="w-1 h-1 bg-outline-variant"></div>
          <div class="w-1 h-2 bg-outline-variant"></div>
        </div>
      </div>
    </div>
  </div>
</section>
