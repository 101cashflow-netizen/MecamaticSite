---
import { TALLER_DATA } from '../data/taller';

const { faqs } = TALLER_DATA;
---

<section class="w-full bg-surface-container py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-outline-variant" id="faq">
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Cabeçalho -->
    <div class="flex items-center gap-4 border-b-2 border-outline-variant pb-6">
      <span class="font-section-number text-section-number text-[#8a7e6b] leading-none select-none">05</span>
      <div>
        <span class="font-label-code text-xs uppercase text-primary-container tracking-widest block font-bold">[BASE DE CONHECIMENTO]</span>
        <h2 class="font-headline-lg text-headline-lg uppercase font-bold text-on-surface">PERGUNTAS FREQUENTES &amp; TRANSPARÊNCIA</h2>
      </div>
    </div>

    <!-- Itens do Accordion -->
    <div class="space-y-4" id="faqAccordion">
      {faqs.map((faq, idx) => (
        <details class="border-2 border-outline-variant bg-surface-container-high transition-colors group" open={idx === 0}>
          <summary class="w-full p-5 text-left flex items-center justify-between gap-4 font-headline-sm text-headline-sm uppercase text-on-surface font-bold hover:text-primary-container transition-colors cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <span>{faq.pergunta}</span>
            <span class="font-label-code text-xl text-primary-container shrink-0 font-bold group-open:hidden">+</span>
            <span class="font-label-code text-xl text-primary-container shrink-0 font-bold hidden group-open:inline">-</span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-secondary font-body-md text-body-md border-t border-outline-variant/60 leading-relaxed">
            {faq.resposta}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
