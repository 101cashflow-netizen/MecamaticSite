---
import { TALLER_DATA } from '../data/taller';
import Icon from './Icon.astro';
import HazardStripe from './HazardStripe.astro';

const { empresa, redesSociais } = TALLER_DATA;
---

<footer class="w-full bg-surface-container-lowest border-t-4 border-outline-variant text-on-surface-variant">
  <HazardStripe heightClass="h-2" />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Coluna 1: Marca -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="font-headline-sm text-headline-sm uppercase text-on-surface font-extrabold tracking-wider">
            {empresa.nome}<span class="text-primary-container">{empresa.sufixo}</span>
          </span>
        </div>
        <p class="font-label-code text-xs text-primary-container uppercase tracking-wider font-bold">
          [SISTEMA_LOCAL // GUARUJÁ-SP]
        </p>
        <p class="font-body-sm text-body-sm text-secondary leading-relaxed">
          Infraestrutura tática de Marketing Digital e Automações de atendimento sob medida para o comércio e serviços da Enseada e Baixada Santista.
        </p>
        <div class="flex items-center gap-3 pt-2">
          {redesSociais.map((rede) => (
            <a
              class="w-9 h-9 bg-surface-container-high border border-outline-variant flex items-center justify-center text-on-surface hover:text-primary-container transition-colors"
              href={rede.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={rede.nome}
            >
              <Icon name={rede.icone} class="w-4 h-4" />
            </a>
          ))}
        </div>
      </div>

      <!-- Coluna 2: Unidade Operacional -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-headline-sm uppercase text-on-surface border-b-2 border-outline-variant pb-2 font-bold">
          Unidade Operacional
        </h3>
        <div class="space-y-2 font-body-sm text-body-sm">
          <div class="flex items-start gap-2">
            <Icon name="location_on" class="w-4 h-4 text-primary-container shrink-0 mt-0.5" />
            <span>
              {empresa.rua || empresa.enderecoLinha1}<br />
              {empresa.bairro}, {empresa.cidade} - {empresa.estado}<br />
              CEP {empresa.cep}
            </span>
          </div>
          <div class="flex items-center gap-2 pt-2">
            <Icon name="schedule" class="w-4 h-4 text-primary-container shrink-0" />
            <span>Seg a Sáb: 09:00 às 18:00</span>
          </div>
        </div>
      </div>

      <!-- Coluna 3: Comunicação Direta -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-headline-sm uppercase text-on-surface border-b-2 border-outline-variant pb-2 font-bold">
          Comunicação Direta
        </h3>
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <Icon name="phone_in_talk" class="w-4 h-4 text-primary-container shrink-0" />
            <div>
              <span class="font-label-code text-[11px] block uppercase text-secondary font-bold">Linha Direta / WhatsApp</span>
              <a class="font-label-code text-label-code text-on-surface hover:text-primary-container font-bold" href={empresa.telefoneLink}>
                {empresa.telefoneFormatado}
              </a>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <Icon name="mail" class="w-4 h-4 text-primary-container shrink-0" />
            <div>
              <span class="font-label-code text-[11px] block uppercase text-secondary font-bold">Despacho Técnico</span>
              <a class="font-label-code text-label-code text-on-surface hover:text-primary-container" href={`mailto:${empresa.email}`}>
                {empresa.email}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Coluna 4: Diretrizes & Termos -->
      <div class="space-y-3">
        <h3 class="font-headline-sm text-headline-sm uppercase text-on-surface border-b-2 border-outline-variant pb-2 font-bold">
          Diretrizes &amp; Termos
        </h3>
        <ul class="space-y-2 font-body-sm text-body-sm">
          <li>
            <a class="hover:text-primary-container transition-colors flex items-center gap-1" href="/aviso-legal">
              <Icon name="chevron_right" class="w-3.5 h-3.5 text-primary-container" />
              Aviso Legal
            </a>
          </li>
          <li>
            <a class="hover:text-primary-container transition-colors flex items-center gap-1" href="/privacidade">
              <Icon name="chevron_right" class="w-3.5 h-3.5 text-primary-container" />
              Política de Privacidade
            </a>
          </li>
          <li>
            <a class="hover:text-primary-container transition-colors flex items-center gap-1" href="/cookies">
              <Icon name="chevron_right" class="w-3.5 h-3.5 text-primary-container" />
              Política de Cookies
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra de Direitos Reservados -->
    <div class="mt-12 pt-8 border-t border-outline-variant flex flex-col md:flex-row items-center justify-between gap-4 font-label-code text-[12px] text-secondary">
      <p>© {new Date().getFullYear()} {empresa.nome} {empresa.sufixo} // {empresa.bairro.toUpperCase()} {empresa.cidade.toUpperCase()} - TODOS OS DIREITOS RESERVADOS.</p>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary-container shadow-[0_0_6px_#ffc400]"></span>
        <span class="text-on-surface font-bold">STATUS: OPERACIONAL EM GUARUJÁ</span>
      </div>
    </div>
  </div>
</footer>
