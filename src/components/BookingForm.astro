---
import { TALLER_DATA } from '../data/taller';
import Icon from './Icon.astro';

const { empresa, servicos } = TALLER_DATA;
---

<section class="w-full bg-background py-20 px-4 sm:px-6 lg:px-8 border-b-4 border-outline-variant" id="agendamento">
  <div class="max-w-7xl mx-auto space-y-12">
    <!-- Cabeçalho -->
    <div class="flex items-center gap-4 border-b-2 border-outline-variant pb-6">
      <span class="font-section-number text-section-number text-[#8a7e6b] leading-none select-none">04</span>
      <div>
        <span class="font-label-code text-xs uppercase text-primary-container tracking-widest block font-bold">[CHECK-IN TÉCNICO]</span>
        <h2 class="font-headline-lg text-headline-lg uppercase font-bold text-on-surface">AGENDE SEU DIAGNÓSTICO TÉCNICO GRATUITO</h2>
      </div>
    </div>

    <!-- Layout Duas Colunas Funcionais -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Formulário (Coluna Esquerda) -->
      <div class="lg:col-span-7 bg-surface-container border-2 border-outline-variant p-6 sm:p-8 shadow-[6px_6px_0px_0px_#000000]">
        <div class="flex items-center justify-between border-b border-outline-variant pb-4 mb-6">
          <span class="font-label-code text-xs uppercase text-primary-container font-bold">PROTOCOLO DE REQUISIÇÃO DIRETA</span>
          <span class="font-label-code text-[11px] text-secondary">RESPOSTA: ≤ {empresa.tempoMedioResposta}</span>
        </div>

        <form class="space-y-5" id="diagnostic-form" novalidate>
          <div>
            <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientName">
              NOME COMPLETO *
            </label>
            <input
              class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none placeholder:text-secondary-container placeholder:font-label-code text-sm"
              id="clientName"
              name="clientName"
              placeholder="DIGITE SEU NOME OU EMPRESA"
              required
              type="text"
            />
            <span class="font-label-code text-[11px] text-error hidden mt-1" id="err-clientName">Por favor, informe seu nome.</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientPhone">
                TELEFONE / WHATSAPP *
              </label>
              <input
                class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none placeholder:text-secondary-container placeholder:font-label-code text-sm"
                id="clientPhone"
                name="clientPhone"
                placeholder="(13) 99999-9999"
                required
                type="tel"
              />
              <span class="font-label-code text-[11px] text-error hidden mt-1" id="err-clientPhone">Informe um telefone de contato.</span>
            </div>
            <div>
              <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientSite">
                LINK DO SITE (SE HOUVER)
              </label>
              <input
                class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none placeholder:text-secondary-container placeholder:font-label-code text-sm"
                id="clientSite"
                name="clientSite"
                placeholder="https://sualoja.com.br"
                type="url"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientService">
                SERVIÇO DESEJADO *
              </label>
              <select
                class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none text-sm font-label-code"
                id="clientService"
                name="clientService"
              >
                {servicos.map((s) => (
                  <option value={s.titulo}>{s.titulo}</option>
                ))}
              </select>
            </div>
            <div>
              <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientDate">
                DIA DE PREFERÊNCIA
              </label>
              <input
                class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none text-sm font-label-code"
                id="clientDate"
                name="clientDate"
                type="date"
              />
            </div>
          </div>

          <div>
            <label class="block font-label-code text-xs uppercase text-secondary mb-2" for="clientNotes">
              COMENTÁRIO / OBSERVAÇÕES
            </label>
            <textarea
              class="w-full bg-surface-container-low border-2 border-outline-variant px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary-container rounded-none placeholder:text-secondary-container placeholder:font-label-code text-sm"
              id="clientNotes"
              name="clientNotes"
              placeholder="DESCREVA BREVEMENTE O DESAFIO DO SEU NEGÓCIO..."
              rows="3"
            ></textarea>
          </div>

          <button
            class="w-full bg-primary-container text-on-primary-fixed font-label-action text-label-action uppercase py-4 px-6 border-2 border-background shadow-[4px_4px_0px_0px_#000000] hover:bg-primary transition-all flex items-center justify-center gap-2 font-bold tracking-wider cursor-pointer active:translate-x-0.5 active:translate-y-0.5"
            type="submit"
          >
            <Icon name="send" class="w-5 h-5 text-on-primary-fixed" />
            <span>ENVIAR PELO WHATSAPP ({empresa.telefoneFormatado})</span>
          </button>
        </form>
      </div>

      <!-- Box Técnico de Contato Rápido (Coluna Direita) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-surface-container-high border-2 border-primary-container p-6 sm:p-8 space-y-6 shadow-[6px_6px_0px_0px_#000000]">
          <div class="flex items-center gap-3 border-b-2 border-outline-variant pb-4">
            <Icon name="phone_in_talk" class="w-8 h-8 text-primary-container" />
            <div>
              <span class="font-label-code text-[11px] uppercase text-primary-container font-bold">CONTATO INSTANTÂNEO</span>
              <h3 class="font-headline-sm text-headline-sm uppercase text-on-surface font-bold">Prefere falar por telefone?</h3>
            </div>
          </div>
          <p class="font-body-md text-body-md text-secondary leading-relaxed">
            Ligue diretamente para nossa base em Guarujá. Você fala de imediato com um especialista técnico sem menus automáticos.
          </p>
          <div class="bg-surface-container-lowest p-4 border border-outline-variant space-y-2">
            <span class="font-label-code text-xs text-secondary block font-bold">LINHA TÉCNICA PRINCIPAL:</span>
            <a class="font-headline-lg text-headline-lg text-primary-container hover:underline block font-bold leading-none" href={empresa.telefoneLink}>
              {empresa.telefoneFormatado}
            </a>
            <span class="font-label-code text-[11px] text-emerald-400 block pt-1">● LINHA DESIMPEDIDA PARA ATENDIMENTO</span>
          </div>
          <a
            class="w-full bg-surface-container-lowest text-on-surface font-label-action text-label-action uppercase py-3.5 px-6 border-2 border-outline-variant hover:border-primary-container hover:text-primary-container transition-all flex items-center justify-center gap-2"
            href={empresa.telefoneLink}
          >
            <Icon name="call" class="w-5 h-5" />
            <span>LIGAR DIRETAMENTE AGORA</span>
          </a>
          <div class="border-t border-outline-variant pt-4 space-y-3 font-body-sm text-body-sm text-secondary">
            <div class="flex items-start gap-2">
              <Icon name="schedule" class="w-4 h-4 text-primary-container shrink-0 mt-0.5" />
              <span><strong>Horário:</strong> Segunda a Sábado das 09:00 às 18:00</span>
            </div>
            <div class="flex items-start gap-2">
              <Icon name="pin_drop" class="w-4 h-4 text-primary-container shrink-0 mt-0.5" />
              <span><strong>Endereço:</strong> {empresa.enderecoCompleto}</span>
            </div>
            <div class="p-2.5 bg-surface-container-lowest border border-outline-variant font-label-code text-xs text-primary-container font-bold">
              [AVISO: RESPOSTA IMEDIATA DENTRO DO HORÁRIO COMERCIAL]
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ whatsappNumero: empresa.whatsappNumero }}>
  const form = document.getElementById('diagnostic-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('clientName');
      const phoneInput = document.getElementById('clientPhone');
      const siteInput = document.getElementById('clientSite');
      const serviceInput = document.getElementById('clientService');
      const dateInput = document.getElementById('clientDate');
      const notesInput = document.getElementById('clientNotes');

      const errName = document.getElementById('err-clientName');
      const errPhone = document.getElementById('err-clientPhone');

      let isValid = true;

      if (!nameInput.value.trim()) {
        errName?.classList.remove('hidden');
        nameInput.focus();
        isValid = false;
      } else {
        errName?.classList.add('hidden');
      }

      if (!phoneInput.value.trim()) {
        errPhone?.classList.remove('hidden');
        if (isValid) phoneInput.focus();
        isValid = false;
      } else {
        errPhone?.classList.add('hidden');
      }

      if (!isValid) return;

      let msg = `*SOLICITAÇÃO DE DIAGNÓSTICO TÉCNICO - GUARUJA TEC*\n\n`;
      msg += `*Nome:* ${nameInput.value.trim()}\n`;
      msg += `*Telefone:* ${phoneInput.value.trim()}\n`;
      if (siteInput.value.trim()) msg += `*Site/Negócio:* ${siteInput.value.trim()}\n`;
      msg += `*Serviço de interesse:* ${serviceInput.value}\n`;
      if (dateInput.value) msg += `*Dia de preferência:* ${dateInput.value}\n`;
      if (notesInput.value.trim()) msg += `*Observações:* ${notesInput.value.trim()}\n`;

      const targetUrl = `https://wa.me/${whatsappNumero}?text=${encodeURIComponent(msg)}`;
      window.open(targetUrl, '_blank', 'noopener,noreferrer');
    });
  }

  // Listener para botões que pré-selecionam serviço e rolam suavemente
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('[data-service-select]');
    if (trigger) {
      const srvTitle = trigger.getAttribute('data-service-select');
      const select = document.getElementById('clientService');
      if (select && srvTitle) {
        select.value = srvTitle;
        const formEl = document.getElementById('agendamento');
        if (formEl) {
          formEl.scrollIntoView({ behavior: 'smooth' });
        }
      }
    }
  });
</script>
